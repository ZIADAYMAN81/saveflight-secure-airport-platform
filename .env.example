# Copy this file to .env in the project root before running `docker compose up`.
# Generate your own secrets - do not reuse the sample values below.
#   JWT_SECRET:           python -c "import secrets; print(secrets.token_hex(32))"
#   DATA_ENCRYPTION_KEY:   python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#                          (32 raw bytes for AES-256-GCM - NOT Fernet.generate_key(), which
#                          happens to produce a format-compatible key but implies the wrong cipher)

# --- Database ---
DB_USER=airport_app
DB_PASSWORD=CHANGE_THIS_STRONG_DB_PASSWORD
DB_NAME=airport_db

# --- Backend secrets ---
JWT_SECRET=CHANGE_ME_GENERATE_WITH_COMMAND_ABOVE
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
STAFF_JWT_ACCESS_TOKEN_EXPIRES_MINUTES=240
DATA_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_COMMAND_ABOVE

# Optional: PEM-encoded RSA private key for boarding-pass digital signatures.
# If unset, a fresh keypair is generated per container start (fine for local/
# demo use, but signatures won't survive a restart - set this for anything
# longer-lived).
BOARDING_PASS_PRIVATE_KEY_PEM=

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Optional: email delivery for the staff 2FA one-time code (in addition to TOTP)
RESEND_API_KEY=
EMAIL_FROM=Save Flight <onboarding@resend.dev>
EMAIL_OTP_EXPIRES_MINUTES=5

# --- Frontend / CORS ---
FRONTEND_ORIGIN=https://localhost
REACT_APP_API_URL=https://localhost/api/v1

# --- Monitoring ---
GRAFANA_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD

# --- Backups ---
BACKUP_PASSWORD=CHANGE_THIS_BACKUP_PASSWORD
