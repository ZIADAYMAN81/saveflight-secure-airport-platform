DATABASE_URL=sqlite:///./app.db
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
STAFF_JWT_ACCESS_TOKEN_EXPIRES_MINUTES=240
DATA_ENCRYPTION_KEY=-T0G16OIKi5-5C5Xju-VNBaQyQHhY1s1GOlOJ-aX3FM=

# Optional: PEM-encoded RSA private key for boarding-pass signing. If unset, a
# fresh keypair is generated per process (fine for local dev, but every prior
# boarding-pass signature becomes unverifiable across a restart - set this in
# any deployment that needs signatures to remain valid over time).
BOARDING_PASS_PRIVATE_KEY_PEM=

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
FRONTEND_ORIGIN=http://localhost:3000

# Optional: email delivery for the staff 2FA one-time code (in addition to TOTP).
# Leave RESEND_API_KEY unset to skip email sending - the code is printed to
# server logs instead, and TOTP remains fully usable either way.
RESEND_API_KEY=
EMAIL_FROM=Save Flight <onboarding@resend.dev>
EMAIL_OTP_EXPIRES_MINUTES=5
